# 이 파일이 프로젝트의 최상위 Lombok 설정이다. 상위 디렉터리 설정은 읽지 않는다.
config.stopBubbling = true

# 생성 코드에 @Generated를 붙여 커버리지·정적 분석 도구가 제외할 수 있게 한다.
lombok.addLombokGeneratedAnnotation = true

# 금지: 쓰면 컴파일 오류가 난다. 이유는 CONVENTIONS.md 참고.
# @Setter, @Data: 상태 변경은 Aggregate Root의 의도가 드러나는 메서드로만 한다.
lombok.setter.flagUsage = error
lombok.data.flagUsage = error
# @SneakyThrows: 검사 예외를 숨긴다.
lombok.sneakyThrows.flagUsage = error
# val/var, experimental: Java 표준 문법(var) 또는 불안정한 기능으로 대체한다.
lombok.val.flagUsage = error
lombok.var.flagUsage = error
lombok.experimental.flagUsage = error
