# 환경 변수 목록과 기본값. 이 파일은 커밋하고, 실제 값은 .env(커밋 금지)나 배포 환경변수로 넣는다.
#
#   local: application-local.yml이 이 파일 → .env 순으로 읽는다(뒤가 우선). OS 환경변수가 가장 우선한다.
#          compose.yaml은 .env만 읽는다. 값을 바꿀 때는 cp .env.example .env 후 .env를 고친다.
#   prod : 파일을 읽지 않는다. 아래 변수를 모두 배포 환경변수로 넣는다(예: docker run --env-file).
#          하나라도 빠지면 시작에 실패한다.
#
# 형식: KEY=value (따옴표 없이). Spring이 properties 형식으로 읽는다.

# ===== DB 접속 (환경마다 다름) =====
DB_HOST=localhost
DB_PORT=3306
DB_NAME=app
DB_USERNAME=app
DB_PASSWORD=app

# ===== 시간대 =====
# Clock 빈과 JPA Auditing의 기준. JVM 기본 시간대(컨테이너는 보통 UTC)와 무관하게 이 값을 쓴다.
APP_TIME_ZONE=Asia/Seoul

# ===== 성능 튜닝: 기준 부하 테스트로 SLO에 맞춘 값 =====
# 기준 환경은 DB가 가장 약한 구성 요소(병목)인 로컬 클러스터다. 아래 값, 특히 DB 쪽(풀 크기, 타임아웃, 락 대기)은
# 그 DB 성능에 맞춘 값이므로, DB 사양이 다른 환경에서는 부하 테스트로 다시 정한다.
#
# SLO: HTTP 응답 2초 이내

# Tomcat
TOMCAT_THREADS_MAX=200
TOMCAT_THREADS_MIN_SPARE=200
TOMCAT_ACCEPT_COUNT=4096
TOMCAT_MAX_CONNECTIONS=10000

# HikariCP (ms)
DB_POOL_MAX_SIZE=49
DB_POOL_CONNECTION_TIMEOUT=3000
DB_POOL_IDLE_TIMEOUT=0
DB_POOL_MAX_LIFETIME=900000

# MySQL 드라이버·세션 (ms, 락 대기는 초)
DB_CONNECT_TIMEOUT=3000
DB_SOCKET_TIMEOUT=60000
DB_LOCK_WAIT_TIMEOUT=3

# JPA
JPA_DEFAULT_BATCH_FETCH_SIZE=300
